# ============================================================
# Dockerfile.preprocessing
# ============================================================
# Stage 1 of the multimodal pipeline:
#   • HDF5 image extraction (label-aware: all Malignant + sampled Benign)
#   • CLAHE + Gaussian preprocessing
#   • Tabular feature engineering (IQR clip, LabelEncode, StandardScale)
#   • Outputs processed arrays to /data/processed/
# ============================================================

FROM tensorflow/tensorflow:2.15.0

LABEL stage="preprocessing"
LABEL description="ISIC 2024 – Image extraction + tabular preprocessing"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-preprocessing.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY src/data_preprocessing.py src/

ENV PYTHONPATH="/app/src:${PYTHONPATH}"
ENV TF_CPP_MIN_LOG_LEVEL=3

# ── Preprocessing entrypoint ─────────────────────────────────────────────────
COPY scripts/preprocess.py scripts/

# Environment defaults
ENV CSV_PATH=/data/train-metadata.csv
ENV HDF5_PATH=/data/train-image.hdf5
ENV IMAGE_DIR=/data/images
ENV OUTPUT_DIR=/data/processed
ENV N_BENIGN=4000

CMD ["python", "scripts/preprocess.py"]
