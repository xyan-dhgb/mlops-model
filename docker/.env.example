# .env - environment variables for docker-compose
# Copy this file to .env and fill in real values.

# Step 1: AWS/S3 settings for the ISIC 2024 dataset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
S3_BUCKET=kltn-isic-2024-colab
S3_RAW_PREFIX=raw
S3_PREPROCESSED_PREFIX=preprocessed
S3_FEATURES_PREFIX=features
S3_SPLITS_PREFIX=splits
S3_INPUT_BUCKET=kltn-isic-2024-colab
S3_INPUT_PREFIX=raw
S3_SYNC_INPUTS=false

# Training hyperparameters.
PHASE1_EPOCHS=20
PHASE2_EPOCHS=10
BATCH_SIZE=32
OVERSAMPLE_RATIO=0.25
CLASS_WEIGHT_MAL=1.2
FINE_TUNE_FROM_LAYER=300
PHASE1_LR=0.001
PHASE2_LR=0.0001
IMAGE_SIZE=224

# MLflow tracking. In EKS, inject credentials from the runtime secret mechanism.
MLFLOW_ENABLE=true
MLFLOW_TRACKING_URI=https://kltn-mlflow-ui.tech/
MLFLOW_EXPERIMENT_NAME=isic2024-efficientnetb3-multimodal
MLFLOW_RUN_NAME=
MLFLOW_REGISTER_MODEL=true
MLFLOW_REGISTERED_MODEL_NAME=isic2024-efficientnetb3-multimodal
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# Drift Monitor.
CHECK_INTERVAL_HOURS=24
PSI_THRESHOLD=0.25
KS_P_THRESHOLD=0.05
