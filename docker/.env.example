# .env — Biến môi trường cho docker-compose
# Sao chép file này thành .env và điền giá trị thực

# ── Bước 1: Google Drive File ID của dataset ISIC 2024 ──────────────────
# Lấy từ URL: https://drive.google.com/file/d/<FILE_ID>/view
GDRIVE_FILE_ID=1Mrr8m5CP-nj9A-d-6AeXlLKjaYY3pAFb

# ── Tùy chỉnh hyperparameters (có thể để mặc định) ──────────────────────
PHASE1_EPOCHS=20
PHASE2_EPOCHS=10
BATCH_SIZE=32
OVERSAMPLE_RATIO=0.25
CLASS_WEIGHT_MAL=1.2
FINE_TUNE_FROM_LAYER=300
PHASE1_LR=0.001
PHASE2_LR=0.0001
IMAGE_SIZE=224

# ── Drift Monitor ────────────────────────────────────────────────────────
CHECK_INTERVAL_HOURS=24
PSI_THRESHOLD=0.25
KS_P_THRESHOLD=0.05
