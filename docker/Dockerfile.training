# ============================================================
# Dockerfile.training
# ============================================================
# Stage 2 of the multimodal pipeline – Two-Phase Training:
#
#   Phase 1 – Head Training
#     EfficientNetB3 backbone FROZEN
#     Loss: Focal Loss (γ=2.0, α=0.75)
#     LR: 1e-3 (Adam), Batch=32, Max 15 epochs
#
#   Phase 2 – Fine-Tuning
#     Unfreeze from layer 300+ (~400 layers)
#     LR: 1e-4, Max 15 epochs
#
#   Outputs: trained model + MLflow artefacts → /models/
# ============================================================

FROM tensorflow/tensorflow:2.15.0-gpu

LABEL stage="training"
LABEL description="ISIC 2024 – Two-Phase EfficientNetB3 Multimodal Training"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY src/              src/
COPY MLflow_signature/ MLflow_signature/
COPY scripts/          scripts/

ENV PYTHONPATH="/app/src:${PYTHONPATH}"
ENV TF_CPP_MIN_LOG_LEVEL=2

# Training hyperparameters (overridable via docker run -e)
ENV CSV_PATH=/data/train-metadata.csv
ENV HDF5_PATH=/data/train-image.hdf5
ENV IMAGE_DIR=/data/images
ENV OUTPUT_DIR=/models
ENV EXPERIMENT_NAME=isic2024_efficientnetb3
ENV PHASE1_EPOCHS=15
ENV PHASE2_EPOCHS=15
ENV BATCH_SIZE=32
ENV OVERSAMPLE_RATIO=0.25
ENV N_BENIGN=4000
ENV MLFLOW_TRACKING_URI=http://mlflow:5000

# GPU memory growth to avoid OOM on shared GPUs
ENV TF_FORCE_GPU_ALLOW_GROWTH=true

CMD ["python", "scripts/run_train.py"]
